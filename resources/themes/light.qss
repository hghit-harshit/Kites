/* ── Global resets ─────────────────────────────────────────────── */
* {
    outline: 0;
}

/* ── Base widgets ───────────────────────────────────────────────── */
QWidget {
    background-color: #ffffff;
    color: #1a1a1a;
    font-size: 13px;
}

/* ── Buttons ────────────────────────────────────────────────────── */
QPushButton {
    background-color: #f0f0f0;
    color: #1a1a1a;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 14px;
    min-height: 24px;
}
QPushButton:hover {
    background-color: #e0e8f5;
    border-color: #2a82da;
}
QPushButton:pressed {
    background-color: #ccdcf5;
    border-color: #1a6bbf;
}
QPushButton:disabled {
    background-color: #dcdcdc;
    color: #969696;
    border-color: #c8c8c8;
}

/* ── Line edits / text inputs ───────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #f5f5f5;
    color: #1a1a1a;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #2a82da;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: #969696;
    background-color: #ececec;
}

/* ── Combo boxes ────────────────────────────────────────────────── */
QComboBox {
    background-color: #f0f0f0;
    color: #1a1a1a;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 24px;
}
QComboBox:hover   { border-color: #2a82da; }
QComboBox:disabled { color: #969696; background-color: #dcdcdc; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
}

/* ── Scroll bars ────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #b0b0b0;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #2a82da; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #b0b0b0;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover { background: #2a82da; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Tab bar ────────────────────────────────────────────────────── */
QTabBar::tab {
    background: #f0f0f0;
    color: #1a1a1a;
    border: 1px solid #c0c0c0;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 5px 12px;
}
QTabBar::tab:selected {
    background: #ffffff;
    border-bottom: 2px solid #2a82da;
    color: #2a82da;
}
QTabBar::tab:hover:!selected { background: #e0e8f5; }

/* ── Menu / menu bar ────────────────────────────────────────────── */
QMenuBar {
    background-color: #ffffff;
    color: #1a1a1a;
}
QMenuBar::item:selected {
    background-color: #e0e8f5;
    color: #1a1a1a;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
}
QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #d0d0d0;
    margin: 3px 8px;
}

/* ── Tool tips ──────────────────────────────────────────────────── */
QToolTip {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #c0c0c0;
    padding: 4px;
}

/* ── Status bar ─────────────────────────────────────────────────── */
QStatusBar {
    background-color: #f5f5f5;
    color: #1a1a1a;
    border-top: 1px solid #d0d0d0;
}

/* ── Group box ──────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    color: #1a1a1a;
}

/* ── Check box / radio button ───────────────────────────────────── */
QCheckBox, QRadioButton { color: #1a1a1a; spacing: 6px; }
QCheckBox:disabled, QRadioButton:disabled { color: #969696; }

/* ── Spin box ───────────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #f5f5f5; /* #191919 for dark */
    color: #1a1a1a;            /* #f0f0f0 for dark */
    border: 1px solid #c0c0c0; /* #606060 for dark */
    border-radius: 4px;
    padding: 3px 6px;
    min-width: 60px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2a82da;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #969696;            /* #787878 for dark */
    background-color: #ececec; /* #2a2a2a for dark */
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #c0c0c0; /* #606060 for dark */
    border-bottom: 1px solid #c0c0c0;
    border-top-right-radius: 4px;
    background-color: #e4e4e4; /* #454545 for dark */
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #d0e4f7; /* #3a5a8a for dark */
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #c0c0c0;
    border-top: 1px solid #c0c0c0;
    border-bottom-right-radius: 4px;
    background-color: #e4e4e4;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #d0e4f7;
}

/* ── Progress bar ───────────────────────────────────────────────── */
QProgressBar {
    background-color: #e0e0e0;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #1a1a1a;
    min-height: 10px;
}
QProgressBar::chunk {
    background-color: #2a82da;
    border-radius: 4px;
}

/* ── Header view (tables/trees) ─────────────────────────────────── */
QHeaderView::section {
    background-color: #f0f0f0;
    color: #1a1a1a;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    padding: 4px 8px;
    font-weight: 600;
}

/* ── Table / tree / list views ──────────────────────────────────── */
QTableView, QTreeView, QListView {
    background-color: #f5f5f5;
    alternate-background-color: #ffffff;
    gridline-color: #e0e0e0;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
}
QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

/* ── Splitter ───────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #d0d0d0;
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }