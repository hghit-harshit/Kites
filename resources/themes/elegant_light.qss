/*
ElegantLight Style Sheet for QT Applications
Light-mode adaptation of ElegantDark (GTRONICK)
Original ElegantDark by: Jaime A. Quiroga P. / GTRONICK
Available at: https://github.com/GTRONICK/QSS/blob/master/ElegantDark.qss
*/
QMainWindow {
	background-color:rgb(240, 240, 240);
}
QTextEdit {
	background-color:rgb(255, 255, 255);
	color: rgb(0, 140, 0);
}
QPushButton{
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
	border-bottom-color: rgb(190, 190, 190);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(30, 30, 30);
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(245, 245, 245, 255));
}
QPushButton:hover{
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(160, 160, 160, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(160, 160, 160, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(160, 160, 160, 255));
	border-bottom-color: rgb(150, 150, 150);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(0, 0, 0);
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(210, 210, 210, 255), stop:1 rgba(160, 160, 160, 255));
}
QPushButton:pressed{
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(200, 200, 200, 255), stop:1 rgba(235, 235, 235, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(200, 200, 200, 255), stop:1 rgba(235, 235, 235, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(200, 200, 200, 255), stop:1 rgba(235, 235, 235, 255));
	border-bottom-color: rgb(190, 190, 190);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(0, 0, 0);
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(205, 205, 205, 255));
}
QPushButton:disabled{
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(200, 200, 200, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(200, 200, 200, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(200, 200, 200, 255));
	border-bottom-color: rgb(200, 200, 200);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(160, 160, 160);
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(235, 235, 235, 255), stop:1 rgba(220, 220, 220, 255));
}
QLineEdit {
	border-width: 1px; border-radius: 4px;
	border-color: rgb(190, 190, 190);
	border-style: inset;
	padding: 0 8px;
	color: rgb(0, 0, 0);
	background:rgb(255, 255, 255);
	selection-background-color: rgb(90, 90, 90);
	selection-color: rgb(255, 255, 255);
}
QLabel {
	color:rgb(30,30,30);	
}
QProgressBar {
	text-align: center;
	color: rgb(30, 30, 30);
	border-width: 1px; 
	border-radius: 10px;
	border-color: rgb(190, 190, 190);
	border-style: inset;
	background-color:rgb(225,225,225);
}
QProgressBar::chunk {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(120, 155, 185, 255));
	border-radius: 5px;
}
QMenuBar {
	background:rgb(240, 240, 240);
}
QMenuBar::item {
	color:rgb(40,40,40);
	spacing: 3px;
	padding: 1px 4px;
	background: transparent;
}

QMenuBar::item:selected {
	background:rgb(200, 200, 200);
}
QMenu::item:selected {
	color:rgb(0,0,0);
	border-width:2px;
	border-style:solid;
	padding-left:18px;
	padding-right:8px;
	padding-top:2px;
	padding-bottom:3px;
	background:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(150, 185, 210, 255));
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(180, 180, 180, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(180, 180, 180, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(180, 180, 180, 255));
	border-bottom-color: rgb(190, 190, 190);
	border-bottom-width: 1px;
}
QMenu::item {
	color:rgb(40,40,40);
	background-color:rgb(250,250,250);
	padding-left:20px;
	padding-top:4px;
	padding-bottom:4px;
	padding-right:10px;
}
QMenu{
	background-color:rgb(250,250,250);
}
QTabWidget {
	color:rgb(0,0,0);
	background-color:rgb(247,246,246);
}
QTabWidget::pane {
		border-color: rgb(190,190,190);
		background-color:rgb(230,230,230);
		border-style: solid;
		border-width: 1px;
    	border-radius: 6px;
}
QTabBar::tab {
	padding:2px;
	color:rgb(20,20,20);
  	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(245, 245, 245, 255));
	border-style: solid;
	border-width: 2px;
  	border-top-right-radius:4px;
   border-top-left-radius:4px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(200, 197, 198, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(200, 197, 198, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(200, 197, 198, 255));
	border-bottom-color: rgb(230,230,230);
}
QTabBar::tab:selected, QTabBar::tab:last:selected, QTabBar::tab:hover {
  	background-color:rgb(230,230,230);
  	margin-left: 0px;
  	margin-right: 1px;
}
QTabBar::tab:!selected {
    	margin-top: 1px;
		margin-right: 1px;
}
QCheckBox {
	color:rgb(40,40,40);
	padding: 2px;
}
QCheckBox:hover {
	border-radius:4px;
	border-style:solid;
	padding-left: 1px;
	padding-right: 1px;
	padding-bottom: 1px;
	padding-top: 1px;
	border-width:1px;
	border-color: rgb(140, 175, 200);
	background-color:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 150), stop:1 rgba(150, 185, 210, 150));
}
QCheckBox::indicator:checked {
	border-radius:4px;
	border-style:solid;
	border-width:1px;
	border-color: rgb(90,90,90);
  	background-color:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(150, 185, 210, 255));
}
QCheckBox::indicator:unchecked {
	border-radius:4px;
	border-style:solid;
	border-width:1px;
	border-color: rgb(140, 175, 200);
  	background-color:rgb(255,255,255);
}
QPlainTextEdit {
	background-color:rgb(255, 255, 255);
	color: rgb(30, 30, 30);
	border-width: 1px;
	border-style: inset;
	border-color: rgb(190, 190, 190);
	border-radius: 4px;
	selection-background-color: rgb(140, 175, 200);
	selection-color: rgb(0, 0, 0);
}
QTextEdit {
	border-width: 1px;
	border-style: inset;
	border-color: rgb(190, 190, 190);
	border-radius: 4px;
	selection-background-color: rgb(140, 175, 200);
	selection-color: rgb(0, 0, 0);
}

/* ── Combo box ──────────────────────────────────────────────────── */
QComboBox {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(255, 255, 255, 255), stop:1 rgba(200, 200, 200, 255));
	border-bottom-color: rgb(190, 190, 190);
	border-bottom-width: 1px;
	border-style: solid;
	border-radius: 4px;
	color: rgb(30, 30, 30);
	padding: 2px 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(245, 245, 245, 255));
}
QComboBox:hover {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(210, 210, 210, 255), stop:1 rgba(160, 160, 160, 255));
}
QComboBox::drop-down {
	border: none;
	width: 20px;
}
QComboBox::down-arrow {
	width: 8px;
	height: 8px;
	border-left: 4px solid transparent;
	border-right: 4px solid transparent;
	border-top: 5px solid rgb(60, 60, 60);
	margin-right: 6px;
}
QComboBox QAbstractItemView {
	background-color:rgb(250,250,250);
	border: 1px solid rgb(190, 190, 190);
	color: rgb(40,40,40);
	selection-background-color: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(150, 185, 210, 255));
	selection-color: rgb(0,0,0);
}

/* ── Table / tree / list views ─────────────────────────────────── */
QTableView, QTreeView, QListView {
	background-color: rgb(255, 255, 255);
	alternate-background-color: rgb(240, 240, 240);
	gridline-color: rgb(210, 210, 210);
	color: rgb(30, 30, 30);
	border: 1px solid rgb(190, 190, 190);
	border-radius: 4px;
}
QTableView::item, QTreeView::item, QListView::item {
	padding: 3px;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(150, 185, 210, 255));
	color: rgb(0, 0, 0);
}
QTableView::item:hover:!selected, QTreeView::item:hover:!selected, QListView::item:hover:!selected {
	background-color: rgb(225, 225, 225);
}
QHeaderView::section {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(245, 245, 245, 255));
	color: rgb(30, 30, 30);
	padding: 4px 6px;
	border: none;
	border-right: 1px solid rgb(200, 200, 200);
	border-bottom: 1px solid rgb(190, 190, 190);
	font-weight: bold;
}
QTableCornerButton::section {
	background-color: rgb(225, 225, 225);
	border: 1px solid rgb(190, 190, 190);
}

/* ── Scroll bars ────────────────────────────────────────────────── */
QScrollBar:vertical {
	background: rgb(230, 230, 230);
	width: 12px;
	margin: 0px;
}
QScrollBar::handle:vertical {
	background: qlineargradient(spread:pad, x1:0, y1:0.5, x2:1, y2:0.5, stop:0 rgba(210, 210, 210, 255), stop:1 rgba(180, 180, 180, 255));
	border: 1px solid rgb(170, 170, 170);
	border-radius: 5px;
	min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: rgb(160, 160, 160); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
	background: rgb(230, 230, 230);
	height: 12px;
	margin: 0px;
}
QScrollBar::handle:horizontal {
	background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 rgba(210, 210, 210, 255), stop:1 rgba(180, 180, 180, 255));
	border: 1px solid rgb(170, 170, 170);
	border-radius: 5px;
	min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: rgb(160, 160, 160); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Group box ──────────────────────────────────────────────────── */
QGroupBox {
	border: 1px solid rgb(190, 190, 190);
	border-radius: 6px;
	margin-top: 10px;
	padding-top: 10px;
	color: rgb(30, 30, 30);
	font-weight: bold;
	background-color: rgb(240, 240, 240);
}
QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 4px;
	color: rgb(40, 40, 40);
}

/* ── Radio button ───────────────────────────────────────────────── */
QRadioButton {
	color:rgb(40,40,40);
	padding: 2px;
}
QRadioButton:hover {
	border-radius:4px;
	border-style:solid;
	padding-left: 1px;
	padding-right: 1px;
	padding-bottom: 1px;
	padding-top: 1px;
	border-width:1px;
	border-color: rgb(140, 175, 200);
	background-color:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 150), stop:1 rgba(150, 185, 210, 150));
}
QRadioButton::indicator {
	width: 13px;
	height: 13px;
	border-radius: 7px;
	border-width:1px;
	border-style:solid;
}
QRadioButton::indicator:unchecked {
	border-color: rgb(140, 175, 200);
	background-color:rgb(255,255,255);
}
QRadioButton::indicator:checked {
	border-color: rgb(90,90,90);
	background-color:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(150, 185, 210, 255));
}

/* ── Spin box ───────────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
	border-width: 1px; border-radius: 4px;
	border-color: rgb(190, 190, 190);
	border-style: inset;
	padding: 0 6px;
	color: rgb(0, 0, 0);
	background:rgb(255, 255, 255);
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(245, 245, 245, 255));
	border-left: 1px solid rgb(190, 190, 190);
	width: 16px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    /* CRITICAL: Force the element size to zero so borders meet at a point */
    width: 0px;
    height: 0px;
    
    /* The Triangle Logic */
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid rgb(60, 60, 60);
}

/* 3. Fix the Down Arrow */
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    /* CRITICAL: Force the element size to zero so borders meet at a point */
    width: 0px;
    height: 0px;
    
    /* The Triangle Logic */
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgb(60, 60, 60);
}

/* ── Slider ─────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
	height: 5px;
	background: rgb(210, 210, 210);
	border: 1px solid rgb(190, 190, 190);
	border-radius: 2px;
}
QSlider::sub-page:horizontal {
	background: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(140, 175, 200, 255), stop:1 rgba(150, 185, 210, 255));
	border-radius: 2px;
}
QSlider::handle:horizontal {
	background: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 225, 225, 255), stop:1 rgba(250, 250, 250, 255));
	border: 1px solid rgb(150, 150, 150);
	width: 15px;
	margin: -6px 0;
	border-radius: 7px;
}
QSlider::handle:horizontal:hover { background: rgb(210, 210, 210); }

/* ── Tool tip ───────────────────────────────────────────────────── */
QToolTip {
	background-color: rgb(250, 250, 250);
	color: rgb(30, 30, 30);
	border: 1px solid rgb(190, 190, 190);
	padding: 4px 6px;
	border-radius: 3px;
}

/* ── Splitter ───────────────────────────────────────────────────── */
QSplitter::handle {
	background-color: rgb(210, 210, 210);
}
QSplitter::handle:hover { background-color: rgb(140, 175, 200); }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }

/* ── Toolbar ────────────────────────────────────────────────────── */
QToolBar {
	background-color: rgb(235, 235, 235);
	border: none;
	spacing: 3px;
	padding: 2px;
}
QToolButton {
	background-color: transparent;
	border: 1px solid transparent;
	border-radius: 4px;
	padding: 3px;
	color: rgb(30, 30, 30);
}
QToolButton:hover {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(210, 210, 210, 255), stop:1 rgba(230, 230, 230, 255));
	border-color: rgb(190, 190, 190);
}
QToolButton:pressed { background-color: rgb(200, 200, 200); }
QToolButton:checked {
	background-color: rgba(140, 175, 200, 120);
	border-color: rgb(140, 175, 200);
}

/* ── Dock widget ────────────────────────────────────────────────── */
QDockWidget {
	color: rgb(30, 30, 30);
	titlebar-close-icon: none;
	border: 1px solid rgb(190, 190, 190);
}
QDockWidget::title {
	background-color: rgb(225, 225, 225);
	padding: 4px 6px;
	border-bottom: 1px solid rgb(190, 190, 190);
}

QStatusBar {
	color:rgb(30,30,30);
}
